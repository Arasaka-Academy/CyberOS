#!/bin/sh
# [INPUT]: cec-ctl 按下/释放事件与本地原生输入客户端。
# [OUTPUT]: 白名单 KEY 手势与 CEC 健康状态。
# [POS]: CEC 输入桥；不依赖 Wayland 虚拟键盘扩展。
# [PROTOCOL]: Update this header on change, then check AGENTS.md
set -eu

runtime_dir=/run/cyberos-tv
status_writer=/usr/lib/cyberos/scripts/cyberos-tv-write-status
input_helper=/usr/lib/cyberos/bin/cyberos-tv-input
held_key=
input_error_file="$runtime_dir/cec-input-error"
cec_pid=
heartbeat_pid=
events_fifo=

cleanup() {
  release_key
  if [ -n "$cec_pid" ]; then
    kill "$cec_pid" 2>/dev/null || true
    wait "$cec_pid" 2>/dev/null || true
    cec_pid=
  fi
  if [ -n "$heartbeat_pid" ]; then
    kill "$heartbeat_pid" 2>/dev/null || true
    wait "$heartbeat_pid" 2>/dev/null || true
    heartbeat_pid=
  fi
  if [ -n "$events_fifo" ]; then
    rm -f "$events_fifo"
    events_fifo=
  fi
  rm -f "$input_error_file"
}

terminate() {
  cleanup
  exit 0
}

trap cleanup EXIT
trap terminate HUP INT TERM

send_key() {
  [ ! -s "$input_error_file" ] || return 0
  if [ -n "$held_key" ] && [ "$held_key" != "$1" ]; then
    "$input_helper" key "$held_key" 0 >/dev/null 2>&1 || true
  fi
  held_key=$1
  if ! "$input_helper" key "$held_key" 1 >/dev/null 2>&1; then
    printf '%s\n' "Native TV input is unavailable" > "$input_error_file"
    "$status_writer" cec degraded "Native TV input is unavailable"
  fi
}

release_key() {
  if [ -n "$held_key" ]; then
    "$input_helper" key "$held_key" 0 >/dev/null 2>&1 || true
    held_key=
  fi
}

publish_status() {
  if [ -s "$input_error_file" ]; then
    "$status_writer" cec degraded "$(sed -n '1p' "$input_error_file")"
  else
    "$status_writer" cec ready "$1"
  fi
}

handle_cec_line() {
  line=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$line" in
    *"user control released"*|*"user_control_released"*) release_key ;;
    *"ui-cmd: 'up'"*) send_key 103 ;;
    *"ui-cmd: 'down'"*) send_key 108 ;;
    *"ui-cmd: 'left'"*) send_key 105 ;;
    *"ui-cmd: 'right'"*) send_key 106 ;;
    *"ui-cmd: 'select'"*|*"ui-cmd: 'enter'"*) send_key 28 ;;
    *"ui-cmd: 'back'"*|*"ui-cmd: 'exit'"*) send_key 1 ;;
    *"ui-cmd: 'play'"*|*"ui-cmd: 'pause'"*|*"ui-cmd: 'play function'"*) send_key 164 ;;
    *"ui-cmd: 'stop'"*) send_key 166 ;;
    *"ui-cmd: 'f1 (blue)'"*) send_key 30 ;;
    *"ui-cmd: 'f2 (red)'"*) send_key 31 ;;
  esac
}

if ! command -v cec-ctl >/dev/null 2>&1; then
  "$status_writer" cec unavailable "cec-ctl is not installed"
  exit 127
fi

rm -f "$input_error_file"
if [ ! -x "$input_helper" ]; then
  printf '%s\n' "Native TV input helper is unavailable" > "$input_error_file"
fi

while :; do
  set -- /dev/cec*
  if [ "$1" = "/dev/cec*" ]; then
    "$status_writer" cec degraded "No CEC adapter detected; keyboard input remains available"
    sleep 5
    continue
  fi
  device=$1
  events_fifo="$runtime_dir/cec-events.$$"
  rm -f "$events_fifo"
  mkfifo -m 0600 "$events_fifo"
  cec-ctl -d "$device" --playback --monitor > "$events_fifo" 2>&1 &
  cec_pid=$!
  (
    while kill -0 "$cec_pid" 2>/dev/null; do
      # STATUS 仅探测连接，绝不注入测试按键。
      if "$input_helper" probe >/dev/null 2>&1; then
        rm -f "$input_error_file"
      else
        printf '%s\n' "Native TV input is unavailable" > "$input_error_file"
      fi
      publish_status "$device"
      sleep 5
    done
  ) &
  heartbeat_pid=$!
  while IFS= read -r event_line; do
    handle_cec_line "$event_line"
  done < "$events_fifo"
  release_key
  wait "$cec_pid" 2>/dev/null || true
  kill "$heartbeat_pid" 2>/dev/null || true
  wait "$heartbeat_pid" 2>/dev/null || true
  cec_pid=
  heartbeat_pid=
  rm -f "$events_fifo"
  events_fifo=
  "$status_writer" cec degraded "CEC monitor stopped; retrying"
  sleep 2
done
