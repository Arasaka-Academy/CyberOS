#!/bin/sh
# [INPUT]: 已确认的 TV 动作、受限 HDMI 选择器与固定运行锁。
# [OUTPUT]: systemd TV 会话及持有独占锁的输出应用和回滚。
# [POS]: hostd 固定宿主命令；与播放器共享内核互斥边界。
# [PROTOCOL]: Update this header on change, then check AGENTS.md
set -eu

test_root=${CYBEROS_TEST_ROOT:-}
case "$test_root" in
  "") ;;
  /*) ;;
  *) printf 'cyberos-tv-mode: CYBEROS_TEST_ROOT must be absolute\n' >&2; exit 1 ;;
esac

state_dir="$test_root/cyberos/state/tv/control"
state_file="$state_dir/desktop-state"
marker_dir="$test_root/cyberos/state/tv"
enabled_marker="$marker_dir/enabled"
selector_file="$test_root/run/cyberos/tv-connector"
applied_selector="$test_root/run/cyberos-tv/applied-connector"
output_lock="$test_root/run/cyberos-tv-output.lock"
systemd_dir="$test_root/etc/systemd/system"
status_url=http://127.0.0.1:3010/api/tv/status
if [ -n "$test_root" ]; then wait_seconds=0; else wait_seconds=90; fi

log() {
  printf 'cyberos-tv-mode: %s\n' "$*"
}

die() {
  printf 'cyberos-tv-mode: %s\n' "$*" >&2
  exit 1
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "must run as root"
}

validate_paths() {
  case "$state_dir:$systemd_dir" in
    /*:/*) ;;
    *) die "state and systemd paths must be absolute" ;;
  esac
}

state_value() {
  key=$1
  sed -n "s/^${key}=//p" "$state_file" | sed -n '1p'
}

validate_unit() {
  case "$1" in
    none) ;;
    *.service)
      case "$1" in *[!a-zA-Z0-9_.@-]*) die "saved display manager unit is invalid" ;; esac
      ;;
    *) die "saved display manager unit is invalid" ;;
  esac
}

load_state() {
  [ -f "$state_file" ] || return 1
  dm_unit=$(state_value DM_UNIT)
  dm_enabled=$(state_value DM_ENABLED)
  dm_active=$(state_value DM_ACTIVE)
  dm_masked=$(state_value DM_MASKED)
  validate_unit "$dm_unit"
  case "$dm_enabled" in
    enabled|enabled-runtime|disabled|static|indirect|generated|linked|linked-runtime|alias|masked|masked-runtime|not-found|unknown) ;;
    *) die "saved display manager enablement is invalid" ;;
  esac
  case "$dm_active:$dm_masked" in
    [01]:[01]) ;;
    *) die "saved TV mode state is invalid" ;;
  esac
}

unit_active() {
  if systemctl is-active --quiet "$1" 2>/dev/null; then printf '1'; else printf '0'; fi
}

capture_state() {
  install -d -o root -g root -m 0700 "$state_dir"
  dm_unit=$(systemctl show display-manager.service --property=Id --value 2>/dev/null || true)
  if [ -z "$dm_unit" ] || [ "$dm_unit" = "display-manager.service" ]; then
    dm_unit=none
  fi
  validate_unit "$dm_unit"
  if [ "$dm_unit" = none ]; then
    dm_enabled=not-found
    dm_active=0
    dm_masked=0
  else
    dm_enabled=$(systemctl is-enabled "$dm_unit" 2>/dev/null || true)
    dm_enabled=${dm_enabled:-unknown}
    case "$dm_enabled" in
      enabled|enabled-runtime|disabled|static|indirect|generated|linked|linked-runtime|alias|masked|masked-runtime|not-found) ;;
      *) dm_enabled=unknown ;;
    esac
    case "$dm_enabled" in
      masked|masked-runtime) dm_masked=1 ;;
      *) dm_masked=0 ;;
    esac
    dm_active=$(unit_active "$dm_unit")
  fi

  temporary=$(mktemp "$state_dir/.desktop-state.XXXXXX")
  trap 'rm -f "$temporary"' EXIT HUP INT TERM
  {
    printf 'DM_UNIT=%s\n' "$dm_unit"
    printf 'DM_ENABLED=%s\n' "$dm_enabled"
    printf 'DM_ACTIVE=%s\n' "$dm_active"
    printf 'DM_MASKED=%s\n' "$dm_masked"
  } > "$temporary"
  chmod 0600 "$temporary"
  mv -f "$temporary" "$state_file"
  trap - EXIT HUP INT TERM
}

write_file_atomically() {
  destination=$1
  directory=${destination%/*}
  install -d -o root -g root -m 0755 "$directory"
  temporary=$(mktemp "$directory/.cyberos-tv-mode.XXXXXX")
  trap 'rm -f "$temporary"' EXIT HUP INT TERM
  cat > "$temporary"
  chmod 0644 "$temporary"
  mv -f "$temporary" "$destination"
  trap - EXIT HUP INT TERM
}

display_manager_dropin() {
  [ "$dm_unit" != none ] || return 0
  printf '%s/%s.d/50-cyberos-tv-mode.conf' "$systemd_dir" "$dm_unit"
}

install_dropins() {
  install -d -o cyberos -g cyberos -m 0750 "$marker_dir"
  marker_tmp=$(mktemp "$marker_dir/.enabled.XXXXXX")
  printf 'enabled\n' > "$marker_tmp"
  chmod 0644 "$marker_tmp"
  mv -f "$marker_tmp" "$enabled_marker"

  dm_dropin=$(display_manager_dropin)
  if [ -n "$dm_dropin" ]; then
    write_file_atomically "$dm_dropin" <<EOF
[Unit]
ConditionPathExists=!$enabled_marker
Conflicts=cyberos-tv.target
EOF
  fi
}

remove_dropins() {
  rm -f "$enabled_marker"
  dm_dropin=$(display_manager_dropin)
  if [ -n "$dm_dropin" ]; then
    rm -f "$dm_dropin"
    rmdir "${dm_dropin%/*}" 2>/dev/null || true
  fi
}

restore_runtime() {
  if [ "$dm_unit" != none ] && [ "$dm_active" = 1 ] && [ "$dm_masked" = 0 ]; then
    systemctl start "$dm_unit" || return 1
  fi
}

stop_video() {
  curl --fail --silent --show-error --max-time 30 --request POST \
    http://127.0.0.1:3010/api/tv/stop-video >/dev/null
}

rollback_enable() {
  log "startup failed; restoring the previous desktop session"
  rm -f "$selector_file"
  systemctl stop cyberos-tv.target 2>/dev/null || true
  systemctl disable cyberos-tv.target 2>/dev/null || true
  remove_dropins
  systemctl daemon-reload 2>/dev/null || true
  if restore_runtime; then
    rm -f "$state_file"
  else
    log "previous desktop session could not be fully restored; keeping $state_file for a later disable retry"
  fi
}

tv_ready() {
  payload=$(curl --fail --silent --show-error --max-time 3 "$status_url" 2>/dev/null) || return 1
  printf '%s' "$payload" | node -e '
    let input = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (chunk) => { input += chunk; });
    process.stdin.on("end", () => {
      const status = JSON.parse(input).status;
      process.exit(status?.enabled === true && status?.state === "ready" ? 0 : 1);
    });
  ' >/dev/null 2>&1
}

wait_until_ready() {
  ready_deadline=$(($(date +%s) + wait_seconds))
  while :; do
    if tv_ready; then return 0; fi
    [ "$(date +%s)" -lt "$ready_deadline" ] || break
    sleep 1
  done
  return 1
}

enable_runtime() {
  install_dropins || return 1
  systemctl daemon-reload || return 1
  if [ "$dm_unit" != none ] && [ "$(unit_active "$dm_unit")" = 1 ]; then
    systemctl stop "$dm_unit" || return 1
  fi
  systemctl enable cyberos-tv.target || return 1
  systemctl start cyberos-vod-player.service || return 1
  systemctl start cyberos-tv.target || return 1
  wait_until_ready
}

enable_tv() {
  if [ "$#" -gt 0 ]; then write_selector "$1"; else rm -f "$selector_file"; fi
  if ! load_state; then capture_state; load_state; fi
  if ! enable_runtime; then
    rollback_enable
    die "TV mode startup failed or did not become ready within ${wait_seconds}s"
  fi
  log "enabled; local HDMI output is using the CyberOS TV shell"
}

disable_tv() {
  stop_video || die "could not stop the current video session; TV mode was left unchanged"
  if ! load_state; then
    systemctl stop cyberos-tv.target 2>/dev/null || true
    systemctl disable cyberos-tv.target 2>/dev/null || true
    rm -f "$enabled_marker"
    rm -f "$selector_file"
    systemctl daemon-reload
    log "already disabled"
    return
  fi
  systemctl stop cyberos-tv.target 2>/dev/null || true
  systemctl disable cyberos-tv.target 2>/dev/null || true
  remove_dropins
  systemctl daemon-reload
  restore_runtime
  rm -f "$state_file"
  rm -f "$selector_file"
  log "disabled; previous desktop session state restored"
}

validate_selector() {
  case "$1" in
    auto) ;;
    HDMI-A-*) suffix=${1#HDMI-A-}; case "$suffix" in ''|0*|*[!0-9]*) die "invalid HDMI connector" ;; esac ;;
    *) die "invalid HDMI connector" ;;
  esac
}

write_selector() {
  validate_selector "$1"
  install -d -m 0755 "${selector_file%/*}"
  selector_tmp=$(mktemp "${selector_file}.XXXXXX")
  printf '%s\n' "$1" > "$selector_tmp"
  chmod 0644 "$selector_tmp"
  mv -f "$selector_tmp" "$selector_file"
}

playback_idle() {
  payload=$(curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3010/api/playback/status) || return 1
  printf '%s' "$payload" | node -e '
    let input=""; process.stdin.setEncoding("utf8"); process.stdin.on("data",chunk=>input+=chunk);
    process.stdin.on("end",()=>{const status=JSON.parse(input).status; process.exit(status?.owner===null && status?.sessionId===null ? 0 : 1);});
  ' >/dev/null 2>&1
}

reconfigure_tv() {
  selected=${1:-auto}
  validate_selector "$selected"
  [ -f "$enabled_marker" ] || die "TV mode is disabled"
  [ -f "$output_lock" ] && [ ! -L "$output_lock" ] || die "TV output lock is unavailable"
  # /run 由 root 持有；固定 inode 不允许服务用户替换。
  exec 9< "$output_lock"
  python3 - "$test_root" <<'PY' || die "TV output lock has unsafe ownership or permissions"
import os, stat, sys
metadata = os.fstat(9)
safe = stat.S_ISREG(metadata.st_mode)
if not sys.argv[1]:
    safe = safe and metadata.st_uid == 0 and metadata.st_mode & 0o022 == 0
sys.exit(0 if safe else 1)
PY
  flock --exclusive --nonblock 9 || die "TV output is already being reconfigured"
  playback_idle || die "End the current playback session before applying an output"
  previous=auto
  if [ -f "$applied_selector" ]; then previous=$(cat "$applied_selector");
  elif [ -f "$selector_file" ]; then previous=$(cat "$selector_file"); fi
  validate_selector "$previous"
  write_selector "$selected"
  # 独占锁持续到应用或回滚结束；命令与内部恢复均不能启动。
  if ! playback_idle; then write_selector "$previous"; die "End the current playback session before applying an output"; fi
  if systemctl restart cyberos-tv.target && wait_until_ready; then
    log "TV output applied"
    return 0
  fi
  write_selector "$previous"
  if systemctl restart cyberos-tv.target && wait_until_ready; then
    die "TV output failed; previous output restored"
  fi
  die "TV output failed; previous output restore also failed"
}

show_status() {
  if [ -f "$enabled_marker" ]; then local_state=enabled; else local_state=disabled; fi
  target_state=$(systemctl is-active cyberos-tv.target 2>/dev/null || true)
  printf 'mode=%s\ntarget=%s\n' "$local_state" "${target_state:-unknown}"
  payload=$(curl --fail --silent --show-error --max-time 3 "$status_url" 2>/dev/null || true)
  if [ -n "$payload" ]; then
    printf '%s' "$payload" | node -e '
      let input = "";
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", (chunk) => { input += chunk; });
      process.stdin.on("end", () => {
        const value = JSON.parse(input).status;
        for (const name of ["weston", "chromium", "vodPlayer", "cec", "gamepad"]) {
          const component = value[name] ?? {};
          console.log(`${name}=${component.state ?? "unknown"}${component.detail ? ` (${component.detail})` : ""}`);
        }
      });
    '
  fi
}

require_root
validate_paths
command -v systemctl >/dev/null 2>&1 || die "systemctl is required"

case "${1:-}" in
  enable) if [ "$#" -gt 1 ]; then enable_tv "$2"; else enable_tv; fi ;;
  reconfigure) reconfigure_tv "${2:-auto}" ;;
  disable) disable_tv ;;
  status) show_status ;;
  *) die "usage: cyberos-tv-mode enable|disable|status|reconfigure [auto|HDMI-A-N]" ;;
esac
